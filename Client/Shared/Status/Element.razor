@using DotDev.Core.Element

<div class="@ElementClass">
    <div class="atomic-number">@Number</div>
    <div class="label">
        <div class="symbol">@Symbol</div>
        <div class="name">@Name</div>
    </div>
    <div class="status">@StatusKey</div>
</div>

@code {
    [Parameter]
    public ElementInfo Info { get; set; }
    [Parameter]
    public string StatusKey { get; set; }

    public int Number => Info?.Number ?? 0;
    public string Symbol => Info?.Symbol ?? string.Empty;
    public string Name => Info?.ElementName ?? string.Empty;
    //public string Mass => Info.Mass;
    //public string WeightStr => Info.WeightStr;
    //public IEnumerable<uint> Weights => Info.Weight ?? new List<uint>();
    public string Material => Info?.Material ?? string.Empty;
    public int Column => Info?.GridColumn ?? 0;
    public int Row => Info?.GridRow ?? 0;
    public string ElementBasic => $"element {Material}";
    public string ElementClass => $"{ElementBasic} {StatusKey}";
}
